# Astra's editable hero-art masters: local only (also in hero-garage-variants.zip); sha256 in the README beside them
assets/blender/hero-art/masters/*.blend

# World map region-plate crop guides: derived from build/world/world-plate.png by build/gen-regions.mjs
assets/design/worldmap/build/guides/

# The original 141 MB v0.2.0 master stays local after its history removal; smaller exports remain tracked.
harness/out/trailer/trailer-v0.2.0.mp4

# Ask 63's UI trailer: captured frames and cuts stay local. `harness/out/trailer/` is otherwise un-ignored.
harness/out/trailer/beats-ui/
harness/out/trailer/trailer-ui-*

# Python bytecode from the trailer editor
harness/trailer/__pycache__/

# Native bundles/build products; signing material stays outside the repository.
dist-native/
.native-build/
*.keystore
*.jks
*.p12
*.mobileprovision
