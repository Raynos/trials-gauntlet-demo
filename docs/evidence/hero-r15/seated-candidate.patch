+import { bikeTuningV2 } from './tuning';
+import { createBikePhysicsV2 } from './bike';
+import { makeTrack } from '../testTracks';
+
+const pose = (index: number) => {
+  const p = P.poses[index]!;
+  return riderRigFromHips(p.hipX, p.hipY, p.torso*Math.PI/180, makeRiderRigPose());
+};
