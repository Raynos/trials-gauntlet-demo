+const interior = (reach: number) => Math.acos((P.upperArm**2+P.forearm**2-(reach*(P.upperArm+P.forearm))**2)/(2*P.upperArm*P.forearm))*180/Math.PI;
+
+describe('seated neutral and deliberate lean intent', () => {
+  it.each(['rookie', 'pro'] as const)('%s physical targets and real sensor chain use the same COM map', cls => {
+    const tuning=bikeTuningV2(cls), offset=RIDER_CHASSIS_TO_AXLE;
+    expect(tuning.rider.poses).toEqual(riderProfileTargets());
+    for(const row of tuning.rider.poses) {
+      const profile=P.poses.find(p=>p.lean===row.lean)!;
+      const rig=riderRigFromCOM(row.x-offset.x,row.y-offset.y,RIDER_TORSO_REST+row.psi,makeRiderRigPose());
+      expect(rig.hips.x).toBeCloseTo(profile.hipX,9);
+      expect(rig.hips.y).toBeCloseTo(profile.hipY,9);
+      expect(rig.torsoAngle).toBeCloseTo(profile.torso*Math.PI/180,12);
+    }
+    const world=createBikePhysicsV2(120);world.loadTrack(makeTrack(),1,{bike:cls});
+    const state=world.getState(), body=state.riderBody!, chain=world.debug().riderChain;
+    const c=Math.cos(state.bike.angle),s=Math.sin(state.bike.angle),dx=body.pos.x-state.bike.pos.x,dy=body.pos.y-state.bike.pos.y;
+    const rig=riderRigFromCOM(dx*c+dy*s-offset.x,-dx*s+dy*c-offset.y,
+      RIDER_TORSO_REST+body.angle-state.bike.angle,makeRiderRigPose());
+    for(const name of ['hips','shoulders','head','elbow','knee'] as const) {
+      const x=rig[name].x+offset.x,y=rig[name].y+offset.y;
+      expect(chain[name].x).toBeCloseTo(state.bike.pos.x+x*c-y*s,9);
+      expect(chain[name].y).toBeCloseTo(state.bike.pos.y+x*s+y*c,9);
+    }
+    const neutral=tuning.rider.poses.find(p=>p.lean===0)!;
+    expect(neutral.y-(-dx*s+dy*c)).toBeCloseTo(tuning.rider.mass*tuning.gravity/tuning.rider.kp*c,9);
+    expect(rig.hips.y-RIDER_SEAT.neutralTopY).toBeGreaterThan(.12);
+    expect(rig.hips.y-RIDER_SEAT.neutralTopY).toBeLessThan(.15);
+  });
+
+  it('keeps a bounded inverse across the sampled full-turn workspace', () => {
+    let worst=0;
+    for(let degrees=-160;degrees<=200;degrees+=10)for(let x=-15;x<=10;x++)for(let y=-5;y<=18;y++) {
+      const p=riderRigFromHips(x*.1,y*.1,degrees*Math.PI/180,makeRiderRigPose());
+      const q=riderRigFromCOM(p.com.x,p.com.y,p.torsoAngle,makeRiderRigPose());
+      worst=Math.max(worst,q.residual);
+    }
+    expect(worst).toBeLessThan(1e-9);
+  });
+  it('locates the neutral hip above the measured seat crown, with room for the buttock envelope', () => {
+    const neutral=pose(1);
+    expect(neutral.hips.x).toBeGreaterThan(RIDER_SEAT.rearX+.12);
+    expect(neutral.hips.x).toBeLessThan(RIDER_SEAT.frontX-.12);
+    // Joint-to-seat clearance, not a claim that the bone origin is a surface contact.
+    expect(neutral.hips.y-RIDER_SEAT.neutralTopY).toBeGreaterThan(.13);
+    expect(neutral.hips.y-RIDER_SEAT.neutralTopY).toBeLessThan(.16);
+    expect(neutral.torsoAngle*180/Math.PI).toBeGreaterThan(60);
+  });
+
+  it('shifts the hips rearward and extends the arms on back lean; forward rises and folds the torso forward', () => {
+    const back=pose(0), neutral=pose(1), forward=pose(2);
