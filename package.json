{
  "name": "trials-gauntlet-demo",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "2.5D physics trials-bike game (Three.js + TypeScript) with a headless evidence harness",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.harness.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness:boot": "tsx harness/boot.ts",
    "harness:replay": "tsx harness/replay.ts",
    "harness:capture": "tsx harness/capture.ts",
    "harness:perf": "tsx harness/perf.ts",
    "harness:gen-input": "tsx harness/gen-input.ts",
    "harness:all": "tsx harness/all.ts",
    "harness:bot": "tsx harness/bot/bot.ts",
    "harness:reflex": "tsx harness/reflex/reflex.ts",
    "harness:stranger": "tsx harness/stranger/cli.ts",
    "harness:pair": "tsx harness/compare/pair.ts",
    "harness:log-verdict": "tsx harness/compare/log.ts",
    "harness:determinism": "tsx harness/gate/determinism.ts",
    "harness:gate": "tsx harness/gate/ship-gate.ts",
    "harness:round": "tsx harness/round.ts",
    "harness:clip": "tsx harness/clip.ts",
    "harness:snapshot-probe": "tsx harness/gate/snapshot-probe.ts",
    "harness:physics-suite": "tsx harness/physics-suite.ts",
    "harness:e2e": "tsx harness/e2e/touch.mts",
    "harness:bench": "tsx harness/bench/bench.ts",
    "harness:bench:profile": "tsx harness/bench/profile.ts",
    "harness:critic-prompt": "tsx harness/compare/critic-prompt.ts",
    "harness:audio": "tsx harness/compare/audio.ts",
    "harness:hero-webkit": "tsx harness/hero-webkit.mts",
    "media:deploy": "cd project/releases && vercel deploy --prod --yes",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.21.0",
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.6.0",
    "@types/three": "0.186.0",
    "agent-browser": "0.37.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright": "1.62.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
